# Supabase project (Dashboard → Project Settings → API)
# These two values are safe to expose to the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Never put the service-role / secret key in a NEXT_PUBLIC_ variable.

# WhatsApp order alerts (server-only, never NEXT_PUBLIC_). See README -> "WhatsApp order alerts".
WAHA_BASE_URL=https://your-waha-server.example.com
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=default
# Fallback numbers, used only when the number is empty in Admin -> Settings. Format 923001234567.
ORDER_ADMIN_WHATSAPP=923001234567
ORDER_SHOP_WHATSAPP=923001234567
# A long random string. Its SHA-256 hash is stored once in the database (see README).
NOTIFY_SECRET=generate-a-long-random-string
